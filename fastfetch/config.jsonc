{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "/home/vig/.config/fastfetch/snorlax.jpg",
    	"height": 12,
    	 "padding": {
            "top": 4,
            "right": 6
        }
    	
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        "break",
	{
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "32",  // = color4
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "32",
        },
        {
            "type": "packages",
            "format": "{pacman} (pacman){?flatpak-all}, {flatpak-all} (flatpak){?}",
            "key": " ",
            "keyColor": "32",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "cursor",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "32", 
        },
        {
            "type": "disk",
            "key": " ",
            "keyColor": "32",
            "folders": "/",
            "format": "{days} days old"
        },
        "break",
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
        },
        "break",
        "break",
    ]
}
